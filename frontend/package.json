{
  "name": "omnidub-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "OmniDub AI - Manhwa, Comic & Video Recap Desktop Studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"node server.cjs\" \"vite\"",
    "server": "node server.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"node server.cjs\" \"vite\" \"wait-on tcp:5173 && electron .\""
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "vite": "^6.1.1",
    "wait-on": "^8.0.2"
  }
}
